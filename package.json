{
  "name": "taxmesh-clm-mdm-pact",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Pact contract tests for TaxMesh CT-00…CT-17 + gateway data-flow/Swagger APIs",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:consumer": "jest --runInBand --testPathPatterns=tests/consumer",
    "test:provider": "ts-node --transpile-only tests/provider/run-all.ts",
    "test:provider:clm": "ts-node --transpile-only tests/provider/clm.provider.verify.ts",
    "test:provider:mdm": "ts-node --transpile-only tests/provider/mdm.provider.verify.ts",
    "test:provider:acc": "ts-node --transpile-only tests/provider/acc.provider.verify.ts",
    "test:provider:tax": "ts-node --transpile-only tests/provider/tax.provider.verify.ts",
    "test:provider:alc": "ts-node --transpile-only tests/provider/alc.provider.verify.ts",
    "test:provider:doc": "ts-node --transpile-only tests/provider/doc.provider.verify.ts",
    "test:provider:gateway": "ts-node --transpile-only tests/provider/gateway.provider.verify.ts",
    "test:contract": "npm run test:consumer && npm run test:provider",
    "test:contract:consumer-only": "npm run test:consumer",
    "test:contract:provider-only": "npm run test:provider"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@pact-foundation/pact": "^16.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "axios": "^1.8.4",
    "babel-jest": "^30.5.2",
    "jest": "^30.0.0",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  }
}
