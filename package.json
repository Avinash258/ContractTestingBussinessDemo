{
  "name": "taxmesh-clm-mdm-pact",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Pact contract tests for TaxMesh CT-00…CT-17 + gateway data-flow/Swagger APIs",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:consumer": "jest --runInBand --testPathPatterns=tests/consumer",
    "test:consumer:all": "npm run test:consumer",
    "test:provider": "ts-node --transpile-only tests/provider/run-all.ts",
    "test:provider:clm": "ts-node --transpile-only tests/provider/clm.provider.verify.ts",
    "test:provider:mdm": "ts-node --transpile-only tests/provider/mdm.provider.verify.ts",
    "test:provider:clm-mdm": "npm run test:provider:clm && npm run test:provider:mdm",
    "test:provider:acc": "ts-node --transpile-only tests/provider/acc.provider.verify.ts",
    "test:provider:tax": "ts-node --transpile-only tests/provider/tax.provider.verify.ts",
    "test:provider:alc": "ts-node --transpile-only tests/provider/alc.provider.verify.ts",
    "test:provider:doc": "ts-node --transpile-only tests/provider/doc.provider.verify.ts",
    "test:provider:gateway": "ts-node --transpile-only tests/provider/gateway.provider.verify.ts",
    "test:contract": "ts-node --transpile-only scripts/run-contract-ci.ts",
    "test:contract:clm-mdm": "ts-node --transpile-only scripts/run-contract-ci.ts --services=CLM,MDM",
    "test:contract:consumer-only": "ts-node --transpile-only scripts/run-contract-ci.ts --consumer-only",
    "test:contract:consumer-only:clm-mdm": "ts-node --transpile-only scripts/run-contract-ci.ts --consumer-only --services=CLM,MDM",
    "test:contract:consumer-only:full": "ts-node --transpile-only scripts/run-contract-ci.ts --consumer-only --full-consumer",
    "test:contract:provider-only": "ts-node --transpile-only scripts/run-contract-ci.ts --provider-only",
    "test:contract:provider-only:clm-mdm": "ts-node --transpile-only scripts/run-contract-ci.ts --provider-only --services=CLM,MDM",
    "test:contract:clm-mdm:full-consumer": "ts-node --transpile-only scripts/run-contract-ci.ts --full-consumer --services=CLM,MDM",
    "test:swagger-coverage": "ts-node --transpile-only scripts/verify-swagger-coverage.ts",
    "test:swagger-coverage:ci": "ts-node --transpile-only scripts/verify-swagger-coverage.ts --fail-on-gap --write-doc",
    "agent:swagger-gaps": "ts-node --transpile-only scripts/swagger-gap-agent.ts",
    "agent:swagger-gaps:report": "ts-node --transpile-only scripts/build-swagger-gap-agent-report.ts",
    "agent:swagger-gaps:dry": "ts-node --transpile-only scripts/swagger-gap-agent.ts --dry-run",
    "sync:gateway": "node scripts/sync-gateway-url.js",
    "gateway:url": "node scripts/resolve-gateway-url.js",
    "send-report": "ts-node --transpile-only scripts/send-report.ts",
    "report:refresh": "ts-node --transpile-only scripts/refresh-reports-from-json.ts",
    "report:open": "node -e \"console.log(require('path').resolve('reports/pact-report.html'))\""
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@pact-foundation/pact": "^16.5.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.24",
    "axios": "^1.8.4",
    "babel-jest": "^30.5.2",
    "exceljs": "^4.4.0",
    "jest": "^30.0.0",
    "nodemailer": "^7.0.13",
    "ts-jest": "^29.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  }
}
